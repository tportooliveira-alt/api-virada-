# ─── Google OAuth (Login + Sheets sync) ─────────────────────────────────────
# Crie em: console.cloud.google.com → APIs → Credenciais → OAuth 2.0
# Ative: Google Sheets API + Google Drive API
NEXT_PUBLIC_GOOGLE_CLIENT_ID=cole_aqui_o_client_id.apps.googleusercontent.com

# ─── Webhooks das plataformas de venda ───────────────────────────────────────
# Token secreto que autentica a origem do aviso (?token=... ou X-Webhook-Token).
HOTMART_TOKEN=cole_token_aleatorio_aqui
EDUZZ_TOKEN=cole_token_aleatorio_aqui
KIWIFY_TOKEN=cole_token_aleatorio_aqui
MONETIZZE_TOKEN=cole_token_aleatorio_aqui
CAKTO_TOKEN=cole_token_aleatorio_aqui
PERFECTPAY_TOKEN=cole_token_aleatorio_aqui

# ─── QUAIS produtos liberam o app ────────────────────────────────────────────
# LEIA ISTO SE VOCE VENDE MAIS DE UM PRODUTO NA MESMA CONTA.
# O painel da plataforma costuma mandar o webhook de "todos os produtos". Sem
# filtro, quem comprar o e-book de R$ 27 ganha o app inteiro — e o REEMBOLSO
# desse e-book derruba o acesso de quem comprou o app.
#
# Aqui vai a lista (separada por virgula) de id, codigo de oferta ou nome do
# produto que DE FATO da acesso ao app. Vale pra qualquer evento: o que nao esta
# na lista nao libera e tambem nao revoga.
#
# Vazio = aceita tudo (e o comportamento antigo; nao quebra quem ja vende).
#
# Como descobrir o codigo certo: faca (ou espere) uma venda, abra
# /admin/membros -> "Ultimos avisos de venda recebidos" e copie o codigo que
# aparece na coluna Motivo do aviso ignorado.
#
# Pode ser numero ou texto: id numerico (ex. 5551234), codigo com letras,
# codigo de oferta ou o nome do produto. Cole exatamente como aparece no painel
# da plataforma — aqui tudo vira texto na hora de comparar.
#
# Ex. Hotmart:  HOTMART_ALLOWED_PRODUCTS=5551234,H1234567A,app-codigo-da-virada
# Ex. Kiwify:   KIWIFY_ALLOWED_PRODUCTS=a1b2c3d4-0000-1111-2222-333344445555,Virada App
HOTMART_ALLOWED_PRODUCTS=
EDUZZ_ALLOWED_PRODUCTS=
KIWIFY_ALLOWED_PRODUCTS=
MONETIZZE_ALLOWED_PRODUCTS=
CAKTO_ALLOWED_PRODUCTS=
PERFECTPAY_ALLOWED_PRODUCTS=

# ─── Acesso ──────────────────────────────────────────────────────────────────
# E-mails que entram sem ter comprado (dono, testadores). Separados por vírgula.
# É por aqui que se abre um preview pra testar no celular — sem mexer no paywall:
# quem não estiver nesta lista e não tiver comprado continua vendo "não é membro".
ADMIN_EMAILS=

# Segredo que assina a sessao do painel /admin (minimo 16 caracteres).
# OBRIGATORIO EM PRODUCAO. E ele que protege a lista de compradores (nome,
# e-mail e o que a pessoa comprou) — dado pessoal, LGPD.
#
# Sem este valor, em producao o painel e as rotas /api/admin/* respondem 503
# ("falta configurar") e NAO abrem pra ninguem. E de proposito: o jeito antigo
# de entrar era um header de texto (`x-admin-email`), que qualquer pessoa forja
# — quem soubesse o endereco lia a lista inteira. Fechado por padrao.
#
# Em desenvolvimento (rodando na sua maquina) o header antigo continua servindo,
# e o painel mostra um aviso vermelho na tela dizendo que a porta esta aberta.
#
# Com o segredo definido, so vale o cookie assinado que o app emite quando voce
# entra com a conta Google que esta em ADMIN_EMAILS. A sessao dura 12 horas.
#
# Gere um valor aleatorio com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Cole o resultado aqui e reinicie o servidor.
ADMIN_SESSION_SECRET=

# Diretório do banco de compradores (SQLite). Vazio = ./data, que é o certo na
# VPS. Num preview serverless aponte pra /tmp/virada — mas saiba que lá o banco
# é efêmero: webhook de venda NÃO funciona em preview, só na VPS.
ACCESS_DB_DIR=

# ─── Pixels de marketing ─────────────────────────────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# ─── IA (opcional, funcionalidades futuras) ──────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
